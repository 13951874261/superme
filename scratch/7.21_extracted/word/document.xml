ine distT="0" distB="0" distL="0" distR="0" wp14:anchorId="0297C119" wp14:editId="1157E950"><wp:extent cx="4958862" cy="2944511"/><wp:effectExtent l="0" t="0" r="0" b="8255"/><wp:docPr id="96258297" name="图片 1"/><wp:cNvGraphicFramePr><a:graphicFrameLocks xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" noChangeAspect="1"/></wp:cNvGraphicFramePr><a:graphic xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:nvPicPr><pic:cNvPr id="96258297" name=""/><pic:cNvPicPr/></pic:nvPicPr><pic:blipFill><a:blip r:embed="rId12"/><a:stretch><a:fillRect/></a:stretch></pic:blipFill><pic:spPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="4964091" cy="2947616"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></pic:spPr></pic:pic></a:graphicData></a:graphic></wp:inline></w:drawing></w:r></w:p><w:p w14:paraId="2A200D3C" w14:textId="67817D53" w:rsidR="00D572F4" w:rsidRDefault="00D572F4" w:rsidP="003E13E3"><w:pPr><w:pStyle w:val="a9"/><w:ind w:left="360"/><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>---</w:t></w:r><w:r w:rsidR="00F90123"><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>4.</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>试用了下单词本，复习的时候只会出现中文提示词，翻转复习的时候甚至不能出现英文的对应原词。这里的功效是否和上面说的词汇矩阵板块重复了</w:t></w:r><w:r w:rsidR="00F11161"><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>。</w:t></w:r></w:p><w:p w14:paraId="3991C10C" w14:textId="0377E886" w:rsidR="00D572F4" w:rsidRDefault="00D572F4" w:rsidP="003E13E3"><w:pPr><w:pStyle w:val="a9"/><w:ind w:left="360"/><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr></w:pPr><w:r><w:rPr><w:noProof/></w:rPr><w:lastRenderedPageBreak/><w:drawing><wp:inline distT="0" distB="0" distL="0" distR="0" wp14:anchorId="3F379380" wp14:editId="4B6782BE"><wp:extent cx="5046785" cy="2996718"/><wp:effectExtent l="0" t="0" r="1905" b="0"/><wp:docPr id="394417035" name="图片 1"/><wp:cNvGraphicFramePr><a:graphicFrameLocks xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" noChangeAspect="1"/></wp:cNvGraphicFramePr><a:graphic xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:nvPicPr><pic:cNvPr id="394417035" name=""/><pic:cNvPicPr/></pic:nvPicPr><pic:blipFill><a:blip r:embed="rId13"/><a:stretch><a:fillRect/></a:stretch></pic:blipFill><pic:spPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="5049151" cy="2998123"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></pic:spPr></pic:pic></a:graphicData></a:graphic></wp:inline></w:drawing></w:r></w:p><w:p w14:paraId="1790C342" w14:textId="55CD84B4" w:rsidR="00CA1B87" w:rsidRDefault="00CA1B87" w:rsidP="003E13E3"><w:pPr><w:pStyle w:val="a9"/><w:ind w:left="360"/><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>---</w:t></w:r><w:r w:rsidR="00F90123"><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>5.</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>听力板块</w:t></w:r></w:p><w:p w14:paraId="0EEFBC84" w14:textId="0B5D8BEC" w:rsidR="00CA1B87" w:rsidRDefault="00CA1B87" w:rsidP="003E13E3"><w:pPr><w:pStyle w:val="a9"/><w:ind w:left="360"/></w:pPr><w:r><w:rPr><w:noProof/></w:rPr><w:drawing><wp:inline distT="0" distB="0" distL="0" distR="0" wp14:anchorId="1ECD9934" wp14:editId="6DDE3D2D"><wp:extent cx="5274310" cy="3131820"/><wp:effectExtent l="0" t="0" r="2540" b="0"/><wp:docPr id="1825985183" name="图片 1"/><wp:cNvGraphicFramePr><a:graphicFrameLocks xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" noChangeAspect="1"/></wp:cNvGraphicFramePr><a:graphic xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:nvPicPr><pic:cNvPr id="1825985183" name=""/><pic:cNvPicPr/></pic:nvPicPr><pic:blipFill><a:blip r:embed="rId14"/><a:stretch><a:fillRect/></a:stretch></pic:blipFill><pic:spPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="5274310" cy="3131820"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></pic:spPr></pic:pic></a:graphicData></a:graphic></wp:inline></w:drawing></w:r></w:p><w:p w14:paraId="742B6035" w14:textId="270DBBE7" w:rsidR="00004018" w:rsidRDefault="00004018" w:rsidP="003E13E3"><w:pPr><w:pStyle w:val="a9"/><w:ind w:left="360"/></w:pPr><w:r><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>建议继续等待生成的内容比较大，是否可考虑异步生成。目前是可以生成成功的。可在左侧的任务调度中查看进展。</w:t></w:r></w:p><w:p w14:paraId="20008E2D" w14:textId="357B80E5" w:rsidR="00004018" w:rsidRDefault="00004018" w:rsidP="003E13E3"><w:pPr><w:pStyle w:val="a9"/><w:ind w:left="360"/><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr></w:pPr><w:r><w:rPr><w:noProof/></w:rPr><w:lastRenderedPageBreak/><w:drawing><wp:inline distT="0" distB="0" distL="0" distR="0" wp14:anchorId="5E0CAD0D" wp14:editId="11337F56"><wp:extent cx="5274310" cy="2752725"/><wp:effectExtent l="0" t="0" r="2540" b="9525"/><wp:docPr id="1" name="图片 1"/><wp:cNvGraphicFramePr><a:graphicFrameLocks xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" noChangeAspect="1"/></wp:cNvGraphicFramePr><a:graphic xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:nvPicPr><pic:cNvPr id="1" name=""/><pic:cNvPicPr/></pic:nvPicPr><pic:blipFill><a:blip r:embed="rId15"/><a:stretch><a:fillRect/></a:stretch></pic:blipFill><pic:spPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="5274310" cy="2752725"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></pic:spPr></pic:pic></a:graphicData></a:graphic></wp:inline></w:drawing></w:r></w:p><w:p w14:paraId="3628FF14" w14:textId="20670B49" w:rsidR="00CA1B87" w:rsidRDefault="00F527A6" w:rsidP="003E13E3"><w:pPr><w:pStyle w:val="a9"/><w:ind w:left="360"/><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>一是</w:t></w:r><w:r w:rsidR="00CA1B87"><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>反复转动，但是生成不出。我感觉整个网站的生成速度非常慢，卡顿频繁，有时候收起折叠都显得卡。我在家里和工作室的多台电脑上都试过，但是都是不流畅。</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>二是大段材料当然最好是能自动生成，但是生成较慢的情况下，能否提供自行上传听力材料的部分，这样我来默写，它进行分析也可以。</w:t></w:r><w:r w:rsidR="007E1694"><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>三是听力可以增加职场或者通用对话场景，尤其强化各国口音、故意打断、信息缺失、网络卡顿等压力因素，提高我的应对能力。</w:t></w:r></w:p><w:p w14:paraId="4812693A" w14:textId="768D75A8" w:rsidR="00CA1B87" w:rsidRDefault="00CA1B87" w:rsidP="003E13E3"><w:pPr><w:pStyle w:val="a9"/><w:ind w:left="360"/><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>---</w:t></w:r><w:r w:rsidR="00F90123"><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>6.</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>口语练习，多角色沙盘看起来设计的非常不错，不过我长按说话后松开根本没有口语表达记录。然后我有两个疑问：一是这个模块作为多角色博弈</w:t></w:r><w:r w:rsidR="001E272E"><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>，我可以自定义场景吗？还是说每次它自动推送的场景都不一样？这个模块可不能是一次性的，是这个英语学习里面的核心。二是多角色博弈这个还是偏商务政务的，要是遇上日常比较放松的全场景，比如1VS1的日常对话，很随意的那些，可以自动生成吗？然后AI体能记录下我们的对话，指出我表达中的疏漏，并给出更好的表达样例。所以这个板块是不是应当增加自定义场景</w:t></w:r><w:r w:rsidR="00595C32"><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>+日常训练的模块。如果不好融二为一，那就干脆分成上下两个不同的情景也可以。</w:t></w:r></w:p><w:p w14:paraId="3A7B0253" w14:textId="71D0F228" w:rsidR="00CA1B87" w:rsidRDefault="00CA1B87" w:rsidP="003E13E3"><w:pPr><w:pStyle w:val="a9"/><w:ind w:left="360"/><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr></w:pPr><w:r><w:rPr><w:noProof/></w:rPr><w:lastRenderedPageBreak/><w:drawing><wp:inline distT="0" distB="0" distL="0" distR="0" wp14:anchorId="77E6E4D6" wp14:editId="0CF2B5C8"><wp:extent cx="5274310" cy="3131820"/><wp:effectExtent l="0" t="0" r="2540" b="0"/><wp:docPr id="1509950151" name="图片 1"/><wp:cNvGraphicFramePr><a:graphicFrameLocks xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" noChangeAspect="1"/></wp:cNvGraphicFramePr><a:graphic xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:nvPicPr><pic:cNvPr id="1509950151" name=""/><pic:cNvPicPr/></pic:nvPicPr><pic:blipFill><a:blip r:embed="rId16"/><a:stretch><a:fillRect/></a:stretch></pic:blipFill><pic:spPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="5274310" cy="3131820"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></pic:spPr></pic:pic></a:graphicData></a:graphic></wp:inline></w:drawing></w:r></w:p><w:p w14:paraId="66B9C229" w14:textId="35FB25D1" w:rsidR="00063DC0" w:rsidRDefault="00063DC0" w:rsidP="003E13E3"><w:pPr><w:pStyle w:val="a9"/><w:ind w:left="360"/><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>----</w:t></w:r><w:r w:rsidR="0034346F"><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>7.</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>演讲模块：试用正常。</w:t></w:r></w:p><w:p w14:paraId="30A99121" w14:textId="6CD8E17B" w:rsidR="00595C32" w:rsidRDefault="00595C32" w:rsidP="003E13E3"><w:pPr><w:pStyle w:val="a9"/><w:ind w:left="360"/><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>总的来说，英语模块的问题</w:t></w:r><w:r w:rsidR="005A54BC"><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>一是</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>貌似是AI调用的反应时间过长，所以很多模块试用</w:t></w:r><w:r w:rsidR="001E48F4"><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>起来</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>有点问题。</w:t></w:r><w:r w:rsidR="001E48F4"><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>需要让它跑起来后我多开展试用才能行。现在主要是试用都有障碍。</w:t></w:r><w:r w:rsidR="005A54BC"><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>二是我的本意是在使用的时候政商务+生活各类日常诸多场景（吃穿住行+日常社交等等）并行的，时间不足的情况下优先政商务学习。所以这些模块多少还是可能需要有明显的分区，不然就像口语</w:t></w:r><w:r w:rsidR="00366056"><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>训练模块一样过于笼统了。</w:t></w:r></w:p><w:p w14:paraId="4F97E80D" w14:textId="77777777" w:rsidR="0091587B" w:rsidRDefault="0091587B" w:rsidP="003E13E3"><w:pPr><w:pStyle w:val="a9"/><w:ind w:left="360"/><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr></w:pPr></w:p><w:p w14:paraId="620F1F2D" w14:textId="77777777" w:rsidR="0091587B" w:rsidRDefault="0091587B" w:rsidP="003E13E3"><w:pPr><w:pStyle w:val="a9"/><w:ind w:left="360"/><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr></w:pPr></w:p><w:p w14:paraId="1280AEEB" w14:textId="77301BEE" w:rsidR="00D515F1" w:rsidRPr="008708E9" w:rsidRDefault="00D515F1" w:rsidP="003E13E3"><w:pPr><w:pStyle w:val="a9"/><w:ind w:left="360"/><w:rPr><w:rFonts w:hint="eastAsia"/><w:b/><w:bCs/><w:sz w:val="28"/><w:szCs w:val="32"/></w:rPr></w:pPr><w:r w:rsidRPr="008708E9"><w:rPr><w:rFonts w:hint="eastAsia"/><w:b/><w:bCs/><w:sz w:val="28"/><w:szCs w:val="32"/></w:rPr><w:t>-----洞察（听）的部分：</w:t></w:r></w:p><w:p w14:paraId="715A10CC" w14:textId="53BA2AA8" w:rsidR="00D515F1" w:rsidRDefault="00557388" w:rsidP="00557388"><w:pPr><w:ind w:left="360"/><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>1.</w:t></w:r><w:r w:rsidR="00D515F1"><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>左侧的知识点推送很零散。</w:t></w:r><w:r w:rsidR="00601605"><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>我希望是成体系的介绍，相当于是一本书的思维导图+具体知识点的推送+简单的解释/举例</w:t></w:r><w:r w:rsidR="008C6EA1"><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>（要求能导出）</w:t></w:r><w:r w:rsidR="00601605"><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>。</w:t></w:r><w:r w:rsidR="001C1266"><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>在我使用时可以折叠起来，需要对照理解时再点击开。</w:t></w:r></w:p><w:p w14:paraId="0D81A062" w14:textId="2B8725CB" w:rsidR="007A66D3" w:rsidRDefault="00557388" w:rsidP="00557388"><w:pPr><w:ind w:left="360"/><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>2.</w:t></w:r><w:r w:rsidR="00EE0135"><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>然后分布式素材上传后，</w:t></w:r><w:r w:rsidR="002A0FCD"><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>试用</w:t></w:r><w:r w:rsidR="00EE0135"><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>显示可以生成训练案例。我希望在分布式素材那个模块增加素材的思维导图+具体知识点推送+简单的解释/举例</w:t></w:r><w:r w:rsidR="008C6EA1"><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>（要求能导出）</w:t></w:r><w:r w:rsidR="002A0FCD"><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>，因为在这块我应该主要上传的是</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>书本居多</w:t></w:r><w:r w:rsidR="00EE0135"><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>。</w:t></w:r><w:r w:rsidR="007A66D3"><w:rPr><w:noProof/></w:rPr><w:lastRenderedPageBreak/><w:drawing><wp:inline distT="0" distB="0" distL="0" distR="0" wp14:anchorId="0F0CF07D" wp14:editId="48447065"><wp:extent cx="5274310" cy="3131820"/><wp:effectExtent l="0" t="0" r="2540" b="0"/><wp:docPr id="1557445630" name="图片 1"/><wp:cNvGraphicFramePr><a:graphicFrameLocks xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" noChangeAspect="1"/></wp:cNvGraphicFramePr><a:graphic xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:nvPicPr><pic:cNvPr id="1557445630" name=""/><pic:cNvPicPr/></pic:nvPicPr><pic:blipFill><a:blip r:embed="rId17"/><a:stretch><a:fillRect/></a:stretch></pic:blipFill><pic:spPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="5274310" cy="3131820"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></pic:spPr></pic:pic></a:graphicData></a:graphic></wp:inline></w:drawing></w:r></w:p><w:p w14:paraId="7C225DD3" w14:textId="689ED179" w:rsidR="00557388" w:rsidRDefault="00557388" w:rsidP="00557388"><w:pPr><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>3.推送的训练案例第三个模块不是通用职场逻辑了，就是通用社交（包含生活中各个场景）。</w:t></w:r><w:r w:rsidR="00E76EC9"><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>同时推送的案例</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>较简单</w:t></w:r><w:r w:rsidR="00C20104"><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>，场景单一</w:t></w:r><w:r w:rsidR="00C90EFB"><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>（不知道是不是因为要和当天的理论知识相结合的原因）</w:t></w:r><w:r w:rsidR="00E76EC9"><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>，</w:t></w:r><w:r w:rsidR="0022274D"><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>然后博弈不够激烈。</w:t></w:r><w:r w:rsidR="00E76EC9"><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>案例前因后果不太完整，基本上是片段式的</w:t></w:r><w:r w:rsidR="00C90EFB"><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>（我觉得整个对话应当有个8-10分钟）</w:t></w:r><w:r w:rsidR="00E76EC9"><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>。</w:t></w:r></w:p><w:p w14:paraId="69AC86D4" w14:textId="3F1CABE9" w:rsidR="008708E9" w:rsidRDefault="008708E9" w:rsidP="00557388"><w:pPr><w:rPr><w:rFonts w:hint="eastAsia"/><w:b/><w:bCs/><w:sz w:val="28"/><w:szCs w:val="32"/></w:rPr></w:pPr><w:r w:rsidRPr="008708E9"><w:rPr><w:rFonts w:hint="eastAsia"/><w:b/><w:bCs/><w:sz w:val="28"/><w:szCs w:val="32"/></w:rPr><w:t>----说的部分</w:t></w:r></w:p><w:p w14:paraId="2330297E" w14:textId="71372F73" w:rsidR="00D47C9C" w:rsidRDefault="00F934D5" w:rsidP="001C29BE"><w:pPr><w:pStyle w:val="a9"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="3"/></w:numPr><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>右侧AI分析的</w:t></w:r><w:r w:rsidRPr="00F934D5"><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>破绽和失分点</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>没办法下拉，看不到相关内容。</w:t></w:r><w:r w:rsidR="00F90123"><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>同时我需要和AI的</w:t></w:r><w:r w:rsidR="001C29BE"><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>打分</w:t></w:r><w:r w:rsidR="00F90123"><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>分析进行交互。</w:t></w:r></w:p><w:p w14:paraId="61FDD4AC" w14:textId="22336F52" w:rsidR="00C3295B" w:rsidRDefault="00D47C9C" w:rsidP="00C3295B"><w:pPr><w:pStyle w:val="a9"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="3"/></w:numPr><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr></w:pPr><w:r><w:rPr><w:noProof/></w:rPr><w:drawing><wp:anchor distT="0" distB="0" distL="114300" distR="114300" simplePos="0" relativeHeight="251661312" behindDoc="0" locked="0" layoutInCell="1" allowOverlap="1" wp14:anchorId="032B4649" wp14:editId="4ADC65A0"><wp:simplePos x="0" y="0"/><wp:positionH relativeFrom="column"><wp:posOffset>46892</wp:posOffset></wp:positionH><wp:positionV relativeFrom="paragraph"><wp:posOffset>392283</wp:posOffset></wp:positionV><wp:extent cx="5099050" cy="2983524"/><wp:effectExtent l="0" t="0" r="6350" b="7620"/><wp:wrapTopAndBottom/><wp:docPr id="1839158460" name="图片 1"/><wp:cNvGraphicFramePr><a:graphicFrameLocks xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" noChangeAspect="1"/></wp:cNvGraphicFramePr><a:graphic xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:nvPicPr><pic:cNvPr id="1839158460" name=""/><pic:cNvPicPr/></pic:nvPicPr><pic:blipFill><a:blip r:embed="rId18" cstate="print"><a:extLst><a:ext uri="{28A0092B-C50C-407E-A947-70E740481C1C}"><a14:useLocalDpi xmlns:a14="http://schemas.microsoft.com/office/drawing/2010/main" val="0"/></a:ext></a:extLst></a:blip><a:stretch><a:fillRect/></a:stretch></pic:blipFill><pic:spPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="5099553" cy="2983818"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></pic:spPr></pic:pic></a:graphicData></a:graphic><wp14:sizeRelH relativeFrom="margin"><wp14:pctWidth>0</wp14:pctWidth></wp14:sizeRelH><wp14:sizeRelV relativeFrom="margin"><wp14:pctHeight>0</wp14:pctHeight></wp14:sizeRelV></wp:anchor></w:drawing></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>AI提供的问题：限定条件已经设置的较为齐全，但是不能仅限于我单独的</w:t></w:r><w:r w:rsidR="003A3180"><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>表述</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>，需要充分提供1VS1或者多人团体社交场景的博弈表达，</w:t></w:r><w:r w:rsidR="003A3180"><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>需要AI设计并将上述条件</w:t></w:r><w:r w:rsidR="003A3180"><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:lastRenderedPageBreak/><w:t>嵌入到某个场景。</w:t></w:r><w:r w:rsidR="00127F43"><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>其实要求是</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>点类似于你在英语板块中设置的场景</w:t></w:r><w:r w:rsidR="0032437E"><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>，只不过是中文/英文环境下的区别，但是此处需要更丰富些，博弈对话的时长由我来决定是否停止（设置停止键）</w:t></w:r><w:r w:rsidR="007A7556"><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>，结束对话后AI再介入分析</w:t></w:r><w:r w:rsidR="002C4739"><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>我与对方的社会阶层、立场、利益、目的、心理侧写等等，给出更好的回答或者表达</w:t></w:r><w:r w:rsidR="007A7556"><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>。</w:t></w:r></w:p><w:p w14:paraId="2681294D" w14:textId="3A20FB93" w:rsidR="00D47C9C" w:rsidRDefault="00D47C9C" w:rsidP="00D47C9C"><w:pPr><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr></w:pPr></w:p><w:p w14:paraId="0319C37C" w14:textId="783F7AAB" w:rsidR="00D420D8" w:rsidRDefault="00D420D8" w:rsidP="00D47C9C"><w:pPr><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr></w:pPr><w:r w:rsidRPr="00980F60"><w:rPr><w:rFonts w:hint="eastAsia"/><w:b/><w:bCs/><w:sz w:val="24"/><w:szCs w:val="28"/></w:rPr><w:t>---读的板块：</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>AI推送的素材都较简短，不如我自己粘贴的网站或者是文档详尽。但是这个模块目前上传是有点问题</w:t></w:r><w:r w: