:rFonts w:hint="eastAsia"/></w:rPr><w:t>战略路线图：</w:t></w:r><w:r w:rsidR="003E13E3" w:rsidRPr="000F74E6"><w:rPr><w:rFonts w:hint="eastAsia"/><w:b/><w:bCs/><w:color w:val="EE0000"/></w:rPr><w:t>干脆不需要达标强制锁定了</w:t></w:r><w:r w:rsidR="003E13E3"><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>，因为我跳到全场景板块之后，也没有办法试用其他场景中生成的内容。而且此处全场景需要增加</w:t></w:r><w:r w:rsidR="000F74E6"><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>（可供我自定义）</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>。</w:t></w:r></w:p><w:p w14:paraId="3E74FC00" w14:textId="4B597CA8" w:rsidR="00EC3D59" w:rsidRDefault="00EC3D59" w:rsidP="003E13E3"><w:pPr><w:pStyle w:val="a9"/><w:ind w:left="360"/></w:pPr><w:r><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>--</w:t></w:r><w:r w:rsidR="00F90123"><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>2.</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>上传材料的地方：处理非常慢，而且不成功。</w:t></w:r></w:p><w:p w14:paraId="74F30EBA" w14:textId="337A3DD9" w:rsidR="00B80A8A" w:rsidRDefault="00B80A8A" w:rsidP="00B80A8A"><w:pPr><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr></w:pPr></w:p><w:p w14:paraId="517A7AF0" w14:textId="4E54D3FB" w:rsidR="00EC3D59" w:rsidRDefault="00EC3D59" w:rsidP="003E13E3"><w:pPr><w:pStyle w:val="a9"/><w:ind w:left="360"/></w:pPr><w:r><w:rPr><w:noProof/></w:rPr><w:drawing><wp:inline distT="0" distB="0" distL="0" distR="0" wp14:anchorId="2755163B" wp14:editId="320EC5FC"><wp:extent cx="4982308" cy="2958433"/><wp:effectExtent l="0" t="0" r="0" b="0"/><wp:docPr id="9174536" name="图片 1"/><wp:cNvGraphicFramePr><a:graphicFrameLocks xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" noChangeAspect="1"/></wp:cNvGraphicFramePr><a:graphic xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:nvPicPr><pic:cNvPr id="9174536" name=""/><pic:cNvPicPr/></pic:nvPicPr><pic:blipF