[Unit]
Description=Super-Agent Vocab Server
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/var/www/super-agent/vocab-server
ExecStart=/usr/bin/node --max-old-space-size=768 /var/www/super-agent/vocab-server/server.js
Restart=always
RestartSec=3
Environment=NODE_ENV=production
EnvironmentFile=/etc/super-agent/vocab.env
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/super-agent/vocab-server/private /var/www/super-agent/vocab-server/public/temp_audio /var/lib/super-agent /var/www/super-agent/vocab-server/public/daily_long_articles /var/www/super-agent/vocab-server/public/daily_listen_audio
MemoryHigh=1100M
MemoryMax=1300M
CPUQuota=150%
TasksMax=256
LimitNOFILE=65536
UMask=0077

[Install]
WantedBy=multi-user.target
